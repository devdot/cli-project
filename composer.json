{
    "name": "devdot/cli-project",
    "description": "Light framework on top of symfony/console.",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Thomas Kuschan",
            "email": "mail@thomaskuschan.de"
        }
    ],
    "require": {
        "devdot/cli": "^1.2"
    },
    "require-dev": {
        "devdot/cli-builder": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12",
        "squizlabs/php_codesniffer": "^4"
    },
    "scripts": {
        "post-create-project-cmd": "cli-builder init --no-interaction",
        "check-static": "phpstan analyse",
        "format": "phpcbf --standard=PSR12 src tests",
        "test": "phpunit tests"
    },
    "config": {
        "sort-packages": true
    }
}
